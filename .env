# Health-Assistant Environment Variables
# Rename this file to .env and fill in your API keys

# ===========================================
# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
# ===========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================
# Dropbox API Configuration
# Get your access token from: https://www.dropbox.com/developers/apps
# Create an app with "Full Dropbox" access
# ===========================================
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token_here

# ===========================================
# Backend API Configuration
# Default: http://localhost:8000
# Change this if deploying to production
# ===========================================
BACKEND_URL=http://localhost:8000

# ===========================================
# Optional: Application Settings
# ===========================================
# LOG_LEVEL=INFO
# MAX_FILE_SIZE_MB=10
# ALLOWED_FILE_TYPES=pdf,jpg,png

GEMINI_API_KEY=test_key_123
